{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gemini-connect",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://gemini-connect.YOUR-SUBDOMAIN.workers.dev",
    "GEMINI_MODEL": "gemini-flash-latest",
    "AUTH_VERSION": "1",
    "OWNER_GOOGLE_EMAIL": "owner@example.com"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "GEMINI_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.md"
      ],
      "fallthrough": true
    }
  ]
}
